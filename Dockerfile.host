# Host dataplane container: transport + CX5 model + GPU ring (simulation by default).
FROM rust:1.85-bookworm

WORKDIR /workspace
COPY . /workspace

RUN cargo build -p aether-radio-cli --release

EXPOSE 9000/udp
CMD ["cargo", "run", "-p", "aether-radio-cli", "--release", "--", "host-recv", "--help"]
